<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" style="-fx-padding: 50;">
    <Label text="Welcome to Dormitory Management System" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
    <Label text="Select an option from the left menu to get started" style="-fx-font-size: 16px; -fx-text-fill: #7F8C8D;"/>

    <VBox spacing="10" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #ecf0f1; -fx-border-radius: 10;">
        <Label text="Quick Stats" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Label text="• Manage Tenants" style="-fx-font-size: 14px;"/>
        <Label text="• Track Room Status" style="-fx-font-size: 14px;"/>
        <Label text="• Process Payments" style="-fx-font-size: 14px;"/>
        <Label text="• Monitor Rent Due" style="-fx-font-size: 14px;"/>
    </VBox>
</VBox>
