<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.dormitory.UserViewController"
            prefWidth="1000" prefHeight="700">

    <!-- Top Header -->
    <top>
        <VBox style="-fx-background-color: #2c3e50;">
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 15 20;">
                <Label text="🏠 Dormitory Management System" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Tenant Portal" style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;"/>
            </HBox>
        </VBox>
    </top>

    <!-- Left Sidebar Menu -->
    <left>
        <VBox spacing="15" prefWidth="220" style="-fx-background-color: #34495e; -fx-padding: 20;">
            <Label text="MENU" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Separator style="-fx-background-color: #2c3e50;"/>

            <Button text="📊 Dashboard" onAction="#handleUserDashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 8 15;"
                    onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit"/>

            <Button text="💳 Make Payment" onAction="#handlePayment"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 8 15;"
                    onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit"/>

            <Button text="📜 Transaction History" onAction="#handleTransactionHistory"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 8 15;"
                    onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit"/>

            <Button text="🔔 Rent Notification" onAction="#handleRentNotification"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 8 15;"
                    onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit"/>

            <Button text="🔑 Change Password" onAction="#handleChangePassword"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 8 15;"
                    onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit"/>

            <Separator style="-fx-background-color: #2c3e50;"/>

            <Button text="🚪 Logout" onAction="#handleLogout"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 15;"
                    onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="5" style="-fx-padding: 10 0 0 0;">
                <Label text="Version 1.0" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                <Label text="© 2024 Dormitory System" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
            </VBox>
        </VBox>
    </left>

    <!-- Center Content Area -->
    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: #ecf0f1;">
            <VBox alignment="CENTER" spacing="20" style="-fx-padding: 50;">
                <Label text="Welcome to Tenant Portal" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Please select an option from the menu" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>
                <ProgressIndicator progress="-1.0" style="-fx-scale-x: 0.8; -fx-scale-y: 0.8;"/>
            </VBox>
        </StackPane>
    </center>

</BorderPane>