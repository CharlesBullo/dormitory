<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.dormitory.AddTenantController"
      spacing="15" style="-fx-padding: 20; -fx-background-color: #ecf0f1;">

    <Label text="Add New Tenant" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Separator/>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
        <GridPane hgap="15" vgap="15">
            <padding>
                <Insets top="10" bottom="10"/>
            </padding>

            <!-- Row 0 -->
            <Label text="Full Name:*" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
            <TextField fx:id="nameField" promptText="Enter full name" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="300"/>

            <!-- Row 1 -->
            <Label text="Contact Number:*" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
            <TextField fx:id="contactField" promptText="Enter contact number" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <!-- Row 2 -->
            <Label text="Email Address:*" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
            <TextField fx:id="emailField" promptText="Enter email address" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <!-- Row 3 -->
            <Label text="Address:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
            <TextField fx:id="addressField" promptText="Enter address (optional)" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <!-- Row 4 -->
            <Label text="Select Room:*" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="4">
                <ComboBox fx:id="roomComboBox" promptText="Choose available room" prefWidth="300"/>
                <Label fx:id="availableRoomsLabel" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                <Button text="Refresh Rooms" onAction="#handleRefreshRooms" style="-fx-font-size: 11px;"/>
            </VBox>

            <!-- Row 5 -->
            <Label text="Room Details:" GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-font-weight: bold;"/>
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="5">
                <Label text="Rent:"/>
                <Label fx:id="roomRentLabel" text="--" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
                <Label text="| Status:"/>
                <Label fx:id="roomStatusLabel" text="--"/>
            </HBox>

            <!-- Row 6 -->
            <Label text="Move-in Date:*" GridPane.columnIndex="0" GridPane.rowIndex="6" style="-fx-font-weight: bold;"/>
            <DatePicker fx:id="moveInDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="6" prefWidth="300"/>

            <!-- Row 7 -->
            <Label text="First Payment Due:" GridPane.columnIndex="0" GridPane.rowIndex="7" style="-fx-font-weight: bold;"/>
            <Label fx:id="dueDateLabel" text="Select move-in date" GridPane.columnIndex="1" GridPane.rowIndex="7" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>

            <columnConstraints>
                <ColumnConstraints minWidth="120"/>
                <ColumnConstraints minWidth="300"/>
            </columnConstraints>
        </GridPane>
    </ScrollPane>

    <Separator/>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Clear Form" onAction="#handleCancel" style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
        <Button text="Register Tenant" onAction="#handleSave" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <VBox spacing="5" style="-fx-padding: 10; -fx-background-color: #fff3cd; -fx-border-color: #ffeaa7; -fx-border-radius: 5;">
        <Label text="📌 Important Notes:" style="-fx-font-weight: bold; -fx-text-fill: #856404;"/>
        <Label text="• Only vacant rooms are shown in the dropdown" style="-fx-font-size: 12px; -fx-text-fill: #856404;"/>
        <Label text="• Rent due date is automatically set to one month after move-in" style="-fx-font-size: 12px; -fx-text-fill: #856404;"/>
        <Label text="• Tenant will be automatically assigned to the selected room" style="-fx-font-size: 12px; -fx-text-fill: #856404;"/>
        <Label text="• Room status will change to OCCUPIED after registration" style="-fx-font-size: 12px; -fx-text-fill: #856404;"/>
    </VBox>
</VBox>