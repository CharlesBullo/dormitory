<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<?import javafx.scene.layout.StackPane?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.dormitory.MainController">
    <top>
        <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #2c3e50;">
            <Label text="Dormitory and Boarding House Management System" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    <left>
        <VBox spacing="10" style="-fx-padding: 10; -fx-background-color: #ecf0f1;" prefWidth="200">
            <Button text="Dashboard" onAction="#handleDashboard" prefWidth="180" style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
            <Button text="Register Tenant" onAction="#handleRegisterTenant" prefWidth="180" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button text="Tenant List" onAction="#handleTenantList" prefWidth="180" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
            <Button text="Rooms" onAction="#handleRooms" prefWidth="180" style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
            <Button text="Payments" onAction="#handlePayment" prefWidth="180" style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="10" style="-fx-padding: 10;">
            <StackPane fx:id="contentPane"/>
        </VBox>
    </center>
</BorderPane>